# Optional. When unset, the app serves artifacts from apps/web/public/artifacts.
# When set, /api/manifests returns direct URLs under this base instead.
GOP_ARTIFACT_BASE_URL=

# Optional local override for public-mode artifacts.
GOP_PUBLIC_ARTIFACTS_ROOT=

# Optional release id used by artifact sync and release scripts.
GOP_RELEASE_ID=

# Optional native-addon diagnostics and strictness.
GOP_LOG_NATIVE_CHECK=
GOP_REQUIRE_NATIVE=

# Set by Vercel/CI in hosted environments; included here for local smoke tests.
VERCEL_ENV=
VERCEL=
CI=

# Vercel sets NODE_ENV automatically. Route handlers that use poker-calculations
# must run on the Node.js runtime, not the Edge runtime.
